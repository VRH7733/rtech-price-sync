# Copy to .env for local runs. NEVER commit .env.
# WooCommerce REST keys: WooCommerce > Settings > Advanced > REST API (Read/Write)
WC_URL=https://rtechelectricals.com
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sent to the three marketplaces inside the User-Agent so they can contact you.
# Use a business address you are happy to expose, not a personal one.
RTECH_CONTACT_EMAIL=CHANGE_ME@example.com
